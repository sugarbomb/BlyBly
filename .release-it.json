{
  "plugins": {
    "release-it-pnpm": {
      "publishCommand": "echo 'skipping publish'"
    }
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm run test --run"
    ],
    "after:bump": [
      "pnpm run legacy:build",
      "pnpm run legacy:build-firefox",
      "pnpm exec rimraf extension.zip extension-firefox.zip extension-firefox-sources.zip",
      "pnpm exec jszip-cli add extension/* -o ./extension.zip",
      "pnpm exec jszip-cli add extension-firefox/* -o ./extension-firefox.zip",
      "git archive HEAD -o extension-firefox-sources.zip"
    ],
    "after:release": [
      "gh release upload v${version} extension.zip extension-firefox.zip",
      "pnpm run submit"
    ]
  }
}
