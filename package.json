{
  "name": "bewly-bewly",
  "displayName": "BlyBly",
  "type": "module",
  "version": "0.5.2",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "homepage": "https://github.com/hakadao/BewlyBewly",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt --mv3",
    "dev-firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build-safari": "wxt build -b safari --mv3",
    "build-firefox": "wxt build -b firefox --mv3",
    "convert-safari": "xcrun safari-web-extension-converter ./.output/safari-mv3 --project-location ./extension-safari-macos --macos-only",
    "pack": "pnpm run pack:zip && pnpm run pack:zip-firefox",
    "pack:zip": "wxt zip --mv3",
    "pack:zip-firefox": "wxt zip -b firefox --mv3",
    "pack:zip-firefox-sources": "wxt zip -b firefox --mv3",
    "pack:crx": "crx pack .output/chrome-mv3 -o ./.output/extension.crx",
    "pack:xpi": "web-ext build --source-dir .output/firefox-mv3 --artifacts-dir .output --filename extension.xpi --overwrite-dest",
    "start:chromium": "web-ext run --source-dir .output/chrome-mv3 --target=chromium",
    "start:firefox": "web-ext run --source-dir .output/firefox-mv3 --target=firefox-desktop",
    "clear": "rimraf .output/chrome-mv3 .output/chrome-mv3-dev",
    "clear-firefox": "rimraf .output/firefox-mv3 .output/firefox-mv3-dev",
    "clear-safari": "rimraf .output/safari-mv3 .output/safari-mv3-dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest --config vitest.config.ts",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "knip": "knip",
    "submit": "run-p submit:*",
    "submit:chrome": "pnpm wxt submit --chrome-zip ./extension.zip",
    "submit:firefox": "pnpm wxt submit --firefox-zip ./extension-firefox.zip --firefox-sources-zip ./extension-firefox-sources.zip",
    "legacy:dev": "npm run legacy:clear && cross-env NODE_ENV=development run-p legacy:dev:*",
    "legacy:dev-firefox": "npm run legacy:clear-firefox && cross-env NODE_ENV=development FIREFOX=true run-p legacy:dev:*",
    "legacy:dev:prepare": "esno scripts/prepare.ts",
    "legacy:dev:web": "vite",
    "legacy:dev:js": "npm run legacy:build:js -- --mode development",
    "legacy:dev:bg": "tsup --watch ./src",
    "legacy:build": "cross-env NODE_ENV=production run-s legacy:clear legacy:build:web legacy:build:prepare legacy:build:js legacy:build:bg",
    "legacy:build-safari": "cross-env NODE_ENV=production SAFARI=true run-s legacy:clear-safari legacy:build:web legacy:build:prepare legacy:build:js legacy:build:bg",
    "legacy:build-firefox": "cross-env NODE_ENV=production FIREFOX=true run-s legacy:clear-firefox legacy:build:web legacy:build:prepare legacy:build:js legacy:build:bg",
    "legacy:build:prepare": "esno scripts/prepare.ts",
    "legacy:build:web": "vite build",
    "legacy:build:js": "vite build --config vite.config.content.ts",
    "legacy:build:bg": "tsup",
    "legacy:convert-safari": "xcrun safari-web-extension-converter ./extension-safari --project-location ./extension-safari-macos --macos-only",
    "legacy:pack": "cross-env NODE_ENV=production run-p legacy:pack:*",
    "legacy:pack:zip": "rimraf extension.zip && jszip-cli add extension/* -o ./extension.zip",
    "legacy:pack:zip-firefox": "rimraf extension-firefox.zip && jszip-cli add extension-firefox/* -o ./extension-firefox.zip",
    "legacy:pack:zip-firefox-sources": "rimraf extension-firefox-sources.zip && git archive HEAD -o extension-firefox-sources.zip",
    "legacy:pack:crx": "crx pack extension -o ./extension.crx",
    "legacy:pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ FIREFOX=true web-ext build --source-dir ./extension-firefox --filename extension.xpi --overwrite-dest",
    "legacy:start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "legacy:start:firefox": "web-ext run --source-dir ./extension-firefox --target=firefox-desktop",
    "legacy:clear": "rimraf --glob extension extension.*",
    "legacy:clear-firefox": "rimraf --glob extension-firefox extension-firefox.*",
    "legacy:clear-safari": "rimraf --glob extension-safari extension-safari.*",
    "legacy:submit": "run-p legacy:submit:*",
    "legacy:submit:chrome": "pnpm wxt submit --chrome-zip ./extension.zip",
    "legacy:submit:firefox": "pnpm wxt submit --firefox-zip ./extension-firefox.zip --firefox-sources-zip ./extension-firefox-sources.zip",
    "check:migration": "esno scripts/check-wxt-migration.ts"
  },
  "dependencies": {
    "@types/md5": "^2.3.5",
    "dompurify": "^3.1.5",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "overlayscrollbars": "2.7.3",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "vue-i18n": "^9.13.1",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.21.1",
    "@ffflorian/jszip-cli": "^3.6.3",
    "@iconify/json": "^2.2.219",
    "@iconify/vue": "^4.1.2",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/dompurify": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.2",
    "@types/webextension-polyfill": "^0.10.7",
    "@unocss/preset-attributify": "0.65.4",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vueuse/core": "^10.11.0",
    "@wxt-dev/module-vue": "1.0.3",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^9.4.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.0",
    "knip": "^5.19.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "release-it": "^17.3.0",
    "release-it-pnpm": "^4.6.1",
    "rimraf": "^5.0.7",
    "sass": "^1.77.5",
    "simple-git-hooks": "^2.11.1",
    "terser": "^5.31.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "unocss": "0.65.4",
    "unplugin-auto-import": "^0.17.6",
    "vite": "6.4.1",
    "vitest": "^1.6.1",
    "vue": "^3.4.27",
    "vue-tsc": "^2.0.21",
    "web-ext": "10.8.0",
    "webext-bridge": "5.0.5",
    "webextension-polyfill": "^0.12.0",
    "wxt": "0.21.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "webExt": {
    "run": {
      "keepProfileChanges": true,
      "firefoxProfile": "./web-ext-profile",
      "chromiumProfile": "./web-ext-profile",
      "startUrl": [
        "https://www.bilibili.com/"
      ]
    }
  }
}
